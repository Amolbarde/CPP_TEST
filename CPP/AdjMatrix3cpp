
//directed unweighted graph
#include<iostream>
#include<vector>
using namespace std;
int main()
{
  int edge,vertex;
 cout<<"Enter no of vector: ";
 cin>>vertex;
 cout<<endl<<"Enter no of edge: ";
 cin>> edge;
 vector<vector<bool>> AdjMat(vertex , vector<bool>(vertex,0));
 int u,v;
 for(int i=0;i<edge;i++)
 {
  cin>>u>>v;
  AdjMat[u][v] = 1;
 } 
 
 for(int i = 0;i<vertex;i++)
 {
  for(int j = 0;j<vertex;j++)
 {
  cout<<AdjMat[i][j]<<" "; 
 }
 cout<<endl;
 }
}

